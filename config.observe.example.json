{
  "listen": "localhost:8443",
  "upstream": "wss://uniproxy.alice.yandex.net/uni.ws",
  "mode": "observe",
  "tls_cert": "certs/server.pem",
  "tls_key": "certs/server.key",
  "allowed_ips": [],
  "conversation_log": {
    "enabled": false,
    "path": "runtime/conversations.jsonl",
    "max_size_mb": 10,
    "max_backups": 3,
    "max_text_chars": 16000
  },
  "assistant_tools": {
    "enabled": false,
    "web": true,
    "history": true,
    "time": true,
    "timezone": "UTC",
    "max_rounds": 3,
    "max_calls": 4,
    "web_timeout_ms": 8000,
    "web_max_bytes": 1048576,
    "web_max_chars": 12000,
    "history_max_scan_mb": 16
  }
}
