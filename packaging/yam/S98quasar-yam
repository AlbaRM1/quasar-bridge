#!/bin/sh
# Optional BusyBox init hook; install explicitly, after checking paths on your firmware.
set -eu
root=/data/quazar/yam
pidfile=$root/yamd.pid
case "${1:-start}" in
 start)
  test -x "$root/bin/yamd"
  if test -s "$pidfile" && kill -0 "$(cat "$pidfile")" 2>/dev/null; then exit 0; fi
  start-stop-daemon --start --background --make-pidfile --pidfile "$pidfile" \
   --startas "$root/bin/yamd" -- --listen 127.0.0.1:8099 --data-dir "$root/data"
  ;;
 stop)
  # Ask yamd to stop the managed service first; killing yamd alone can orphan its child.
  wget -q -O /dev/null --post-data='' http://127.0.0.1:8099/api/plugins/quasar-bridge/stop || true
  i=0
  while wget -q -O /dev/null http://127.0.0.1:8443/healthz; do
   i=$((i+1)); test "$i" -lt 15 || { echo 'bridge did not stop; keeping yamd running' >&2; exit 1; }
   sleep 1
  done
  if test -s "$pidfile"; then kill "$(cat "$pidfile")" 2>/dev/null || true; rm -f "$pidfile"; fi
  ;;
 restart) "$0" stop; "$0" start ;;
 *) echo 'usage: S98quasar-yam start|stop|restart' >&2; exit 2 ;;
esac
